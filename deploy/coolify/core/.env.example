# CORE resource variables. Set them in Coolify, never in git.
# Generate secrets with `openssl rand -hex 32`. One set per environment.
#
# [BUILD]   = mark "Available at Buildtime" in Coolify (interpolated by the
#             compose; Coolify only gives build-time variables to the build).
# [RUNTIME] = runtime only (NOT build time): secrets must never become build
#             arguments. They reach the containers through the .env Coolify
#             injects into every service.

# [BUILD] Dedicated OpenFarm network, created beforehand (not --internal in
# production: the processor needs outbound access). Shared with EDGE only.
OPENFARM_CORE_NETWORK=agromind-openfarm-prod
# [BUILD] Celery worker replicas: 1 in production, 0 for rehearsals.
OPENFARM_PROCESSOR_REPLICAS=1
# [BUILD] Celery Beat (openfarm-scheduler): 1 = periodic refresh on (weekly
# indices Mon 06:00 UTC, daily weather 08:00 UTC), 0 = off. Never more than 1.
OPENFARM_SCHEDULER_REPLICAS=0

# [RUNTIME] Alert rules (index threshold/drop, soil). Keep false: the current
# rules produce false positives. Refresh of indices/weather never needs them.
OPENFARM_ALERT_RULES_ENABLED=false

# [RUNTIME] PostGIS
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=openfarm
# [RUNTIME] MinIO root credentials
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# [RUNTIME] Processor connection settings (unique CORE hostnames)
DATABASE_URL=postgresql+asyncpg://<user>:<password>@openfarm-db:5432/openfarm
# psycopg2 is mandatory (SQLAlchemy 2.1 would pick psycopg3, not installed).
DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@openfarm-db:5432/openfarm
REDIS_URL=redis://openfarm-redis:6379/0
MINIO_ENDPOINT=openfarm-minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=openfarm

# [BUILD] Optional, non-secret (defaults = current production values):
# STAC_API_URL, SOILGRIDS_WCS_BASE_URL, SOIL_FETCH_TIMEOUT_SECONDS=60,
# SOIL_SOURCE_PRIORITY=soilgrids, POLARIS_S3_BUCKET=
