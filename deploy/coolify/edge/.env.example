# EDGE resource variables (api + tiler). Set them in Coolify, never in git.
# [BUILD] / [RUNTIME]: see core/.env.example.

# [BUILD] Same dedicated network as CORE.
OPENFARM_CORE_NETWORK=agromind-openfarm-prod
# [BUILD] Network where the AgroMind backend lives: `coolify` in production.
OPENFARM_BACKEND_NETWORK=coolify
# [BUILD] Aliases on that network: <alias>-api and <alias>-tiler.
OPENFARM_NETWORK_ALIAS=openfarm-prod

# [RUNTIME] API
DATABASE_URL=postgresql+asyncpg://<user>:<password>@openfarm-db:5432/openfarm
DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@openfarm-db:5432/openfarm
REDIS_URL=redis://openfarm-redis:6379/0
# Shared with the AgroMind backend of the SAME environment.
OPENFARM_JWT_SECRET=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=openfarm

# [RUNTIME] Same value as CORE (the API process never evaluates rules today,
# but both resources must agree).
OPENFARM_ALERT_RULES_ENABLED=false

# [RUNTIME] Tiler reads COGs from MinIO with these (same values as MINIO_*).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# [BUILD] Optional, non-secret: MINIO_ENDPOINT (default openfarm-minio:9000),
# CORS_ORIGINS, TITILER_PUBLIC_URL, STAC_API_URL, SOILGRIDS_WCS_BASE_URL,
# SOIL_FETCH_TIMEOUT_SECONDS=60, SOIL_SOURCE_PRIORITY=soilgrids, POLARIS_S3_BUCKET=
