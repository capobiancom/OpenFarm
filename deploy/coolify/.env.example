# Variables for deploy/coolify/docker-compose.yml.
# Set them in the Coolify resource, never in git. Generate secrets with
# `openssl rand -hex 32`. Every environment (prod, dev) gets its OWN values.

# External network joined by ALL six services (Coolify attaches every
# top-level network to every service; it cannot be limited to api/tiler).
# Must be DEDICATED: an isolated `docker network create --internal` network
# for rehearsals, or a network reserved for OpenFarm + the AgroMind backend in
# production. NEVER Coolify's global `coolify` network. Create it beforehand.
OPENFARM_SHARED_NETWORK=

# Stable aliases on that network: <alias>-api and <alias>-tiler
# (e.g. openfarm-prod-api, openfarm-prod-tiler).
OPENFARM_NETWORK_ALIAS=openfarm-prod

# Celery worker replicas: 1 normally, 0 to keep it from being created at all
# (isolated rehearsals, maintenance windows).
OPENFARM_PROCESSOR_REPLICAS=1

# PostgreSQL / PostGIS
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=openfarm

# Internal URLs use the unique hostnames declared in the compose
# (openfarm-db, openfarm-redis, openfarm-minio), never the short service names.
DATABASE_URL=postgresql+asyncpg://<user>:<password>@openfarm-db:5432/openfarm
# psycopg2 is mandatory (SQLAlchemy 2.1 would pick psycopg3, not installed).
DATABASE_URL_SYNC=postgresql+psycopg2://<user>:<password>@openfarm-db:5432/openfarm
REDIS_URL=redis://openfarm-redis:6379/0

# Engine API <-> AgroMind backend shared secret (HS256). Must equal
# OPENFARM_JWT_SECRET in the AgroMind backend of the SAME environment.
OPENFARM_JWT_SECRET=

# MinIO (object storage for COGs)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_ENDPOINT=openfarm-minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=openfarm

# Optional (defaults in the compose)
CORS_ORIGINS=http://localhost
TITILER_PUBLIC_URL=http://tiler
STAC_API_URL=https://earth-search.aws.element84.com/v1
SOILGRIDS_WCS_BASE_URL=
POLARIS_S3_BUCKET=
SOIL_FETCH_TIMEOUT_SECONDS=
SOIL_SOURCE_PRIORITY=
